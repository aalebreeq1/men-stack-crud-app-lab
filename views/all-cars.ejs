<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cars</title>
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="/all-cars-style.css">
</head>

<body>
    <%- include('partials/navbar')%>

    <div class="page-content">
        <div class="page-header">
            <h1>View All Cars</h1>
            <a href="/cars/new" class="btn-new">+ Add New Car</a>
        </div>
            <div id="grid">
                <% for (let car of cars) { %>
                    <a href="/cars/<%= car._id %>" class="card-link">
                        <div class="card">
                            <div class="card-img">
                                <img src="<%= car.img_url %>" alt="<%= car.name %> img">
                            </div>
                            <div class="card-content">
                                <h3><%= car.name %></h3>
                                <p><strong>Type:</strong> <%= car.type %></p>
                                <p><strong>Make:</strong> <%= car.make %></p>
                                <p><strong>Year:</strong> <%= car.year %></p>
                                <p><strong>MSRP:</strong> <%= car.MSRP %> BHD</p>
                                <p><strong>Dealer:</strong> <%= car.dealer %></p>
                                <p><strong>Engine:</strong> <%= car.engine_type %></p>
                            </div>
                        </div>
                    </a>
                <% } %>
            </div>
    </div>
</body>

</html>