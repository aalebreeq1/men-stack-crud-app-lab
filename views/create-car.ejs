<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Car</title>
</head>

<body>
    
    <h1>Create Car</h1>

    <form action="../server.js" method="POST">
        <label for="name">Car Name:</label>
        <input type="text" id="name" name="name" required placeholder="Enter car name  Example: Porsche Macan">

        <label for="type">Car Type:</label>
        <select id="type" name="type" required placeholder="Select car type">
            <option value="Sedan">Sedan</option>
            <option value="SUV">SUV</option>
            <option value="Truck">Truck</option>
            <option value="Coupe">Coupe</option>
            <option value="Crossover">Crossover</option>
        </select>

        <label for="make">Car Make:</label>
        <input type="text" id="make" name="make" required placeholder="Enter Car Make, Example: Porsche">

        <label for="year">Car Year</label>
        <input type="number" id="year" name="year" required placeholder="Enter Car Year, Example: 2026">

        <label for="MSRP">Car MSRP in BHD:</label>
        <input type="number" id="MSRP" name="MSRP" required placeholder="Enter Car MSRP  in BHD, Example: 26,000">

        <label for="dealer">Car Dealer:</label>
        <input type="text" id="dealer" name="dealer" required placeholder="Enter Car Dealer in Bahrian, Example: Kanoo">


        <label for="engine_type">Car Engine Type:</label>
        <select id="engine_type" name="engine_type" required placeholder="Select Engine Type:">
            <option value="Petrol">Petrol</option>
            <option value="Diesel">Diesel</option>
            <option value="Electric">Electric</option>
            <option value="Hybrid">Hybrid</option>
        </select>
        <label for="image_url">Car Image URL:</label>
        <input type="text" id="image_url" name="image_url" required
            placeholder="Enter Car Image URL, Example: https://example.com/car.jpg">

        <button type="submit">Create Car</button>
    </form>

</body>

</html>